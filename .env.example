# Copy to .env and fill in. Never commit .env.

# ---- Slack (see "Slack setup" in README.md) ----
# Bot token: everyone uses the SAME one as the connector owner (get it from them privately,
# never commit it). It's what `npm run backfill` and the permission checks use.
SLACK_BOT_TOKEN=xoxb-...
# App-level token: only needed when SLACK_SYNC=on (the connector owner). Others can leave it.
SLACK_APP_TOKEN=xapp-...

# Persona emails, used only by `npm run seed:slack`
CAROL_EMAIL=you@gmail.com
ALICE_EMAIL=alice.demo@gmail.com
BOB_EMAIL=bob.demo@gmail.com
DAVE_EMAIL=dave.demo@gmail.com

# Live Slack sync. Leave "off" unless you are the connector owner.
# Why: Slack delivers each live event to only ONE of the servers connected with this app.
# If two people have it "on", each server gets only some new messages and both indexes
# end up incomplete. With "off", run `npm run backfill` to pull the latest messages;
# backfill reads Slack's history directly, so it always gets everything.
# The connector owner (exactly one person) sets this to "on" for live updates.
SLACK_SYNC=off

# ---- Elasticsearch / server ----
ES_URL=http://localhost:9200
ES_INDEX=brain
PORT=3000
# 1 = save raw Slack events to fixtures/captured/ (for writing tests)
CAPTURE_EVENTS=0

# ---- LLM for "Ask" (any OpenAI-compatible API; see README for more providers) ----
# Tencent Cloud international (TokenHub):
LLM_BASE_URL=https://tokenhub-intl.tencentcloudmaas.com/v1
LLM_MODEL=hy4-preview
LLM_API_KEY=sk-...
# Optional extra JSON merged into each request. For hy4-preview this turns off slow "thinking":
LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
