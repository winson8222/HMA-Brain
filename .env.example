# Copy to .env and fill in. Never commit .env.

# ---- Slack ----
# Slack tokens live in slack-tokens.json, not here (see slack-tokens.example.json and README.md).
# (Old single-workspace setups: SLACK_BOT_TOKEN / SLACK_APP_TOKEN here still work if there's no slack-tokens.json.)

# Demo persona emails (the test accounts in the demo Slack workspace), used only by `npm run seed:slack`.
# Carol is the workspace owner: put the owner's own email here.
CAROL_EMAIL=you@gmail.com
ALICE_EMAIL=alicehmatest@gmail.com
BOB_EMAIL=bobhmatest@gmail.com
DAVE_EMAIL=davehmatest@gmail.com

# Live Slack sync. Leave "off" unless you are the connector owner.
# Why: Slack delivers each live event to only ONE of the servers connected with this app.
# If two people have it "on", each server gets only some new messages and both indexes
# end up incomplete. With "off", run `npm run backfill` to pull the latest messages;
# backfill reads Slack's history directly, so it always gets everything.
# The connector owner (exactly one person) sets this to "on" for live updates.
SLACK_SYNC=off

# ---- Web app ----
# Where people reach this app. Slack sends people back here after they approve Connect,
# so this address (+ /slack/oauth/callback) must be in each Slack app's Redirect URLs.
PUBLIC_URL=http://localhost:3000
# on: the UI can act as anyone (Demo mode, side-by-side compare). off: only "Me" (the
# signed-in person). Use off for anything shared beyond your team.
ALLOW_IMPERSONATION=on
# Secret that signs the login cookie. Any long random string; keep it private.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# ---- Elasticsearch / server ----
ES_URL=http://localhost:9200
ES_INDEX=brain
PORT=3000
# Time zone for the times the model sees ("20:39 SGT"). Default Asia/Singapore.
TIME_ZONE=Asia/Singapore
# 1 = save raw Slack events to fixtures/captured/ (for writing tests)
CAPTURE_EVENTS=0

# ---- LLM for "Ask" (any OpenAI-compatible API) ----
# Keep ONE provider block uncommented. Each person can use their own API key.

# Tencent Cloud international, TokenHub (key: console.tencentcloud.com/tokenhub -> API Key;
# activate the model in the console first)
LLM_BASE_URL=https://tokenhub-intl.tencentcloudmaas.com/v1
LLM_MODEL=hy4-preview
LLM_API_KEY=your-tokenhub-api-key
# Turns off hy4-preview's slow "thinking" (~5s answers instead of ~60s)
LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}

# Optional: give up on an LLM call after this long and retry (up to LLM_ATTEMPTS times).
# LLM_TIMEOUT_MS=15000
# LLM_ATTEMPTS=3

# Tencent Cloud China site, Hunyuan (key: console.cloud.tencent.com/hunyuan)
# LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
# LLM_MODEL=hunyuan-turbos-latest
# LLM_API_KEY=your-hunyuan-api-key
# LLM_EXTRA_BODY=

# OpenRouter (key: openrouter.ai/keys; model IDs at openrouter.ai/models)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4o-mini
# LLM_API_KEY=your-openrouter-api-key
# LLM_EXTRA_BODY=

# OpenAI (key: platform.openai.com/api-keys)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=your-openai-api-key
# LLM_EXTRA_BODY=

# Local model with Ollama (no key; data stays on your machine)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=
# LLM_EXTRA_BODY=

# ---- Hybrid retrieval (all optional; each degrades gracefully when unset) ----
# RETRIEVAL_MODE: "lexical" (BM25 only) or "hybrid" (BM25 + vector search, fused).
#   Default: hybrid when EMBEDDING_MODEL and EMBEDDING_DIMS are set, else lexical.
# RERANK: "on" or "off". Default: on when COHERE_API_KEY is set.
# RETRIEVAL_MODE=
# RERANK=
# MULTI_QUERY: rephrase the question N ways for extra semantic search passes (off = 1 pass).
#   A number 1-5, or "on" for 2. Costs one extra LLM call per query; needs LLM_* configured.
# MULTI_QUERY=

# Vector search: any OpenAI-compatible /embeddings endpoint.
# Leave EMBEDDING_BASE_URL / EMBEDDING_API_KEY empty to reuse LLM_BASE_URL / LLM_API_KEY.
# EMBEDDING_DIMS must match the model's output size and sets the index mapping:
# changing it (or setting it for the first time) requires `npm run backfill`.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_DIMS=

# Cohere Rerank (https://dashboard.cohere.com/api-keys — the free Trial key works)
COHERE_API_KEY=
# COHERE_MODEL=rerank-v3.5

# ---- Langfuse tracing (https://cloud.langfuse.com → project Settings → API Keys) ----
# Per-query waterfall (embed → search → fuse → rerank → LLM). Tracing is off when unset.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ---- Google Drive connector (see docs/drive-setup.md) ----
# OAuth client of the "HMA Brain" Google Cloud app (Google Auth Platform -> Clients). Never commit real values.
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
# Where `npm run drive:connect` saves the admin's refresh token (gitignored).
# GOOGLE_TOKEN_FILE=.secrets/google-token.json
# Poll Drive's changes feed from the server. Unlike Slack, several people can have this on at once.
DRIVE_SYNC=off
DRIVE_POLL_SECONDS=60
# Wait until an edited file has been quiet this long before re-indexing it (Docs autosave constantly).
# Sharing changes and deletes are never delayed; "Sync now" skips the wait. 0 = off.
# DRIVE_QUIET_SECONDS=120
# The folder to ingest: a folder with this name in the admin's My Drive, or set its ID directly.
DRIVE_ROOT_FOLDER_NAME=Company A
# DRIVE_ROOT_FOLDER_ID=
# DRIVE_INDEX=brain-drive
# DRIVE_STATE_INDEX=brain-drive-state
# Full reconcile while the server runs (minutes, 0 = off).
# DRIVE_RECONCILE_MINUTES=60
# For the in-app Connect button; must be registered on the OAuth client. Defaults to <PUBLIC_URL>/connect/google/callback
# GOOGLE_REDIRECT_URI=

# ---- Jira connector (Jira Cloud; see docs/jira-connector-plan.md) ----
# A service account with Browse on the projects to ingest and the "Administer Jira" global permission
# (needed to read permission schemes and to re-check each result as the asker). API token:
# id.atlassian.com/manage-profile/security/api-tokens. Never commit it.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Project keys to ingest, comma-separated. Empty: every project the service account can see.
# JIRA_PROJECTS=PAY,SEC
# "Connect Jira": how each person links their own Atlassian account (there's no email matching).
# developer.atlassian.com/console/myapps → Create → OAuth 2.0 integration → Permissions: User identity API (read:me)
# → Authorization callback URL: <PUBLIC_URL>/connect/jira/callback. People who haven't connected see nothing from Jira.
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
# JIRA_REDIRECT_URI=
# Demo data (`npm run seed:jira`, docs/jira-mock-data-plan.md). Seed only: the connector never uses these.
# A site admin's classic API token (Carol's).
# JIRA_ADMIN_EMAIL=
# JIRA_ADMIN_API_TOKEN=
# Optional: each persona's own token, so their seeded comments are posted as them (else "On behalf of …").
# ALICE_JIRA_API_TOKEN=
# BOB_JIRA_API_TOKEN=
# DAVE_JIRA_API_TOKEN=
# Optional: when an email search can't find someone (hidden email), their Atlassian account ID.
# CAROL_JIRA_ACCOUNT_ID=  ALICE_JIRA_ACCOUNT_ID=  BOB_JIRA_ACCOUNT_ID=  DAVE_JIRA_ACCOUNT_ID=  CRAWLER_JIRA_ACCOUNT_ID=
# Poll for updated issues and permission changes from the server. Several people can have this on at once.
JIRA_SYNC=off
# JIRA_POLL_SECONDS=60
# Sweep for deleted issues (minutes, 0 = off). Deleted issues are withheld at query time even before this.
# JIRA_RECONCILE_MINUTES=60
# JIRA_INDEX=brain-jira
# JIRA_STATE_INDEX=brain-jira-state

# ---- Confluence connector (same Atlassian site and crawler as Jira; see docs/confluence-connector-plan.md) ----
# The crawler needs Confluence product access, View on every space to ingest, a place in every page view
# restriction (admins don't bypass restrictions), and the "Confluence Administrator" global permission
# (for the live re-check). People link their Atlassian account once, with Connect Jira.
# Set CONFLUENCE_SYNC (on or off) to enable the connector. on: poll for page and permission changes from the server.
CONFLUENCE_SYNC=off
# Space keys to ingest, comma-separated. Empty: every space the crawler can view.
# CONFLUENCE_SPACES=ENG,SEC,VEND
# Only when Confluence is NOT on the Jira site: these default to JIRA_BASE_URL / JIRA_EMAIL / JIRA_API_TOKEN.
# CONFLUENCE_BASE_URL=
# CONFLUENCE_EMAIL=
# CONFLUENCE_API_TOKEN=
# CONFLUENCE_POLL_SECONDS=60
# Reconcile (minutes, 0 = off): re-list pages (deletes) and re-read every view restriction (a restriction change
# alone may not count as a modification). Small for the demo site; raise it for a big one.
# CONFLUENCE_RECONCILE_MINUTES=10
# CONFLUENCE_INDEX=brain-confluence
# CONFLUENCE_STATE_INDEX=brain-confluence-state
# Demo data (`npm run seed:confluence`, docs/confluence-demo-content.md): uses JIRA_ADMIN_EMAIL with
# JIRA_ADMIN_API_TOKEN or CAROL_JIRA_API_TOKEN (Carol's classic token). Seed only; the connector never uses it.

# ---- Admin panel (/drive.html): audit log and Connect Google Drive ----
# 16+ random characters, e.g. `openssl rand -hex 24`. Admin features are off while this is empty. Keep it private.
ADMIN_TOKEN=
# Tamper-evident audit log. The HMAC key is generated in .secrets/audit-key if AUDIT_KEY is unset; don't lose it.
# AUDIT_INDEX=brain-audit
# AUDIT_KEY=
